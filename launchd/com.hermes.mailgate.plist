<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.mailgate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/brainz/SourceCode/mailgate/.venv/bin/mailgate</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/mailgate.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/mailgate.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>MAILGATE_BIND_HOST</key>
        <string>127.0.0.1</string>
        <key>MAILGATE_BIND_PORT</key>
        <string>8765</string>
    </dict>
</dict>
</plist>
